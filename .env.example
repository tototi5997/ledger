# Supabase API，浏览器可见。来自 Supabase Project Settings / API。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 本地站点地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 数据库 migration 专用 Postgres 连接串。不要暴露到浏览器，不要提交真实值。
# 优先使用 Supabase 的 direct connection / session pooler 连接串。
# 格式示例：
# postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# 如果你想把应用运行连接串和 migration 连接串分开，也可以改用 DIRECT_URL。
# db:migrate 会按顺序读取 DATABASE_URL、DIRECT_URL、SUPABASE_DB_URL、POSTGRES_URL。
# DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# 可选。普通业务读写不应使用 service role key。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
